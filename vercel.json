{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/prisma/dev.db"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?route=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
